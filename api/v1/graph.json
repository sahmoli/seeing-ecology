  "edges": [
    {
      "source": "habitat-fragmentation",
      "target": "umbrella",
      "type": "constrains",
      "context": {
        "zh": "大面积伞护种保护区划定受制于生境总量丧失（H）与控制 H 后的空间构型。",
        "en": "Umbrella reserve sizing is constrained by habitat loss (H) and spatial configuration per se."
      }
    },
    {
      "source": "habitat-fragmentation",
      "target": "keystone",
      "type": "affects",
      "context": {
        "zh": "斑块缩小与边缘暴露可引发关键捕食者或工程师的功能性丧失。",
        "en": "Small, edge-dominated fragments can trigger functional loss of keystone predators or engineers."
      }
    },
    {
      "source": "habitat-fragmentation",
      "target": "metapopulation",
      "type": "prereq",
      "context": {
        "zh": "斑块化景观中的物种存续取决于局部灭绝—再定殖与源—汇动态。",
        "en": "Persistence in fragmented landscapes depends on extinction–recolonization and source–sink dynamics."
      }
    },
    {
      "source": "flagship",
      "target": "umbrella",
      "type": "contrasts",
      "context": {
        "zh": "旗舰种按受众魅力选拔，不自动具备大面积生境伞护效应（Simberloff 1998）。",
        "en": "Selected for public appeal rather than habitat co-occurrence (Simberloff 1998)."
      }
    },
    {
      "source": "umbrella",
      "target": "keystone",
      "type": "contrasts",
      "context": {
        "zh": "伞护种看空间包络与管理净益，关键种看相对丰度不成比例的群落影响（Power et al. 1996）。",
        "en": "Umbrellas target spatial overlap and management gain; keystones reflect disproportionate community impact relative to abundance (Power et al. 1996)."
      }
    },
    {
      "source": "keystone",
      "target": "trophic-cascade",
      "type": "extends",
      "context": {
        "zh": "顶级捕食者型关键种常驱动跨营养级下行级联（Estes et al. 2011）。",
        "en": "Apex-predator keystones frequently drive top-down trophic cascades (Estes et al. 2011)."
      }
    },
    {
      "source": "biodiversity-credits",
      "target": "umbrella",
      "type": "prereq",
      "context": {
        "zh": "多项信用规程借伞护种家域界定项目边界，但核证需一篮子多维指标（Wauchope et al. 2024）。",
        "en": "Several crediting protocols use umbrella ranges for boundaries while relying on multi-metric baskets for verification (Wauchope et al. 2024)."
      }
    }
  ]
